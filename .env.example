# Copie para .env e ajuste. O .env nunca vai para o git.
# Todas as variaveis abaixo tem valor padrao — o servidor sobe sem .env nenhum.

# Porta em que o Node escuta. O Caddy fala com ela por dentro (Fase 5).
PORTA=3000

# Aparece no cabecalho da pagina do convidado.
NOME_ANIVERSARIANTE=

# OBRIGATORIA. Da acesso ao album em /?k=TOKEN e vira o QR code da mesa.
# Sem ela o servidor se recusa a subir — album desprotegido por variavel
# esquecida e o tipo de falha que so aparece na hora errada.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ALBUM_TOKEN=Melina Ribeiro

# Onde ficam o banco e as fotos. Um unico volume Docker cobre os dois.
DIR_DADOS=./dados

# Tamanho maximo por foto. Precisa bater com o request_body max_size do Caddy:
# se divergirem, o erro que chega ao convidado fica incompreensivel.
MAX_ARQUIVO_MB=12

# Teto de arquivos por requisicao. O cliente envia um por vez; isto e defesa.
MAX_ARQUIVOS_POR_REQUISICAO=10

# Quantas fotos o sharp processa ao mesmo tempo. A VPS tem 2 vCPU — nao suba.
CONCORRENCIA_IMAGEM=2

# Como o Express descobre o IP real do convidado atras do Caddy.
TRUST_PROXY=loopback
